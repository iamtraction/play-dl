{
	"compilerOptions": {
		"strict": true,
		"moduleResolution": "bundler",
		"ignoreDeprecations": "6.0",
		"removeComments": false,
		"alwaysStrict": true,
		"pretty": true,
		"target": "es2022",
		"lib": ["ES2022"],
		"types": ["node"],
		"sourceMap": true,
		"inlineSources": true,
		"module": "preserve",
		"declaration": true,
		"declarationMap": true,
		"rootDir": "play-dl",
		"outDir": "dist",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true
	},
	"include": ["play-dl/**/**/*.ts"],
	"exclude": ["play-dl/**/__tests__"]
}
