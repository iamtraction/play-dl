{
  "name": "@iamtraction/play-dl",
  "version": "2.0.1",
  "description": "YouTube, SoundCloud, Spotify, Deezer searching and streaming for discord-js bots",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "directories": {
    "example": "examples"
  },
  "scripts": {
    "build": "tsup",
    "build:check": "tsc --noEmit --incremental false",
    "pretty": "prettier --config .prettierrc \"play-dl/*.ts\" \"play-dl/*/*.ts\" \"play-dl/*/*/*.ts\" --write ",
    "prepublishOnly": "tsup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamtraction/play-dl.git"
  },
  "keywords": [
    "node-youtube-dl",
    "youtube-dl",
    "yt-dl",
    "ytdl",
    "youtube",
    "spotify-dl",
    "spotify",
    "soundcloud",
    "deezer"
  ],
  "author": "iamtraction",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/iamtraction/play-dl/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "homepage": "https://iamtraction.github.io/play-dl/",
  "files": [
    "dist/*"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "prettier": "^3.9.5",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-extras": "^4.0.1",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "play-audio": "^0.5.2"
  }
}
